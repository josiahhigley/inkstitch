<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension translationdomain="inkstitch" xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Objects</name>
    <id>org.{{ id_inkstitch }}.objects_pane</id>
    <param name="extension" type="string" gui-hidden="true">objects_pane</param>
    <effect implements-custom-gui="true" show-stderr="true">
        <object-type>all</object-type>
        <menu-tip>Select or delete imported designs in a merged document</menu-tip>
        <effects-menu>
            <submenu name="{{ menu_inkstitch }}" translatable="no">
                <submenu name="Edit" />
            </submenu>
        </effects-menu>
    </effect>
    <script>
        {{ command_tag | safe }}
    </script>
</inkscape-extension>
